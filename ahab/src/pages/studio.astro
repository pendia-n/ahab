---
import Layout from "../layouts/Layout.astro";
import PageHeading from "../components/PageHeading.astro";
import { TASKS, EXPLAINER_THEMES } from "../lib/offers";
---

<Layout title="Your next take" app protect active="create">
  <PageHeading
    eyebrow="YOUR IDEA. YOUR NEXT TAKE."
    title="Make something worth watching."
    description="Prepare your words and references, review them, then use one allowance."
  >
    <a class="button secondary small" href="/purchases">
      Buy allowances →
    </a>
  </PageHeading>
  <div id="studio-availability" class="notice" hidden></div>
  <div class="studio-grid">
    <form id="generate-form" class="studio-editor">
      <section class="panel">
        <div class="panel-header">
          <h2>
            <span class="section-step">1</span>Choose your video
          </h2>
        </div>
        <div class="field">
          <label for="task-type">Video type</label>
          <select id="task-type" name="taskType">
            {TASKS.map((t) => (
              <option value={t.id}>{t.name}</option>
            ))}
          </select>
          <p class="field-help" id="task-description"></p>
        </div>
        <div class="field" id="studio-style-field" hidden>
          <label for="studio-style">How will you tell it?</label>
          <select id="studio-style">
            {EXPLAINER_THEMES.map((t) => (
              <option value={t.id}>{t.name}</option>
            ))}
          </select>
          <p id="studio-style-help" class="field-help" hidden>
            Explanations longer than 30 seconds use an on-camera presenter.
            Choose up to 30 seconds for visual scenes.
          </p>
        </div>
        <div class="field-row">
          <div class="field">
            <label for="duration">Video length · seconds</label>
            <input
              id="duration"
              name="duration"
              type="number"
              value="30"
              min="5"
              max="120"
              step="1"
              required
            />
          </div>
          <div class="field">
            <label for="resolution">Resolution</label>
            <select id="resolution">
              <option value="1080p">1080p</option>
              <option value="720p">720p</option>
            </select>
          </div>
        </div>
        <div class="field" id="studio-service-field" hidden>
          <label for="studio-service">Generation option</label>
          <select id="studio-service">
            <option value="standard">Standard</option>
          </select>
        </div>
        <p id="duration-note" class="notice" aria-live="polite"></p>
        <div class="field">
          <label for="allowance">Use an allowance</label>
          <select id="allowance" name="allowanceId">
            <option value="">Loading allowances…</option>
          </select>
          <p class="field-help" id="allowance-help">
            Choose a compatible allowance. You do not need to use the others
            today.
          </p>
        </div>
      </section>
      <section class="panel">
        <div class="panel-header">
          <h2>
            <span class="section-step">2</span>Prepare your reference
          </h2>
          <span id="image-counter">0 selected</span>
        </div>
        <p class="field-help">
          Keep character portraits separate from product or subject images.
          Uploading does not edit an image.
        </p>
        <h3>Character / portrait images</h3>
        <p class="field-help">
          Select a portrait to use directly, or select up to 14 character
          references for an optional portrait edit.
        </p>
        <div class="upload-zone">
          <strong>Upload a character portrait</strong>
          <input
            type="file"
            data-upload="image"
            data-reference-role="character"
            accept="image/jpeg,image/png,image/webp"
            aria-label="Upload character portrait"
          />
        </div>
        <div id="image-choices" class="asset-choices"></div>
        <details class="portrait-form">
          <summary>Edit character portrait (optional)</summary>
          <p class="field-help">
            Uses the portrait edit included with your video allowance. Only
            selected character images are edited. Use images you have permission
            to use; editing does not establish permission.
          </p>
          <label for="portrait-prompt">
            What should change in the character portrait?
          </label>
          <textarea
            id="portrait-prompt"
            rows="3"
            maxlength="6000"
            placeholder="Change the outfit to a blue shirt; preserve the pose and soft lighting."
          ></textarea>
          <p
            id="included-image-status"
            class="field-help"
            aria-live="polite"
          ></p>
          <button
            class="button secondary small"
            type="button"
            id="create-portrait"
          >
            Edit selected portrait
          </button>
          <p id="portrait-status" class="form-status" role="status"></p>
        </details>
        <h3>Product / subject images</h3>
        <p class="field-help">
          Product images are used directly and are never sent to the portrait
          editor.
        </p>
        <div class="upload-zone">
          <strong>Upload a product or subject image</strong>
          <input
            type="file"
            data-upload="image"
            data-reference-role="subject"
            accept="image/jpeg,image/png,image/webp"
            aria-label="Upload product or subject image"
          />
        </div>
        <div id="subject-choices" class="asset-choices"></div>
        <div class="field">
          <label for="video-image">Image to animate</label>
          <select id="video-image"></select>
          <p class="field-help">
            Only this image is forwarded to the video model. To show a person
            and product together, upload a scene image already containing both.
            Separate uploads are not automatically combined.
          </p>
        </div>
        <p id="upload-status" class="form-status" role="status"></p>
      </section>
      <section class="panel">
        <div class="panel-header">
          <h2>
            <span class="section-step">3</span>Your words and direction
          </h2>
        </div>
        <div class="field">
          <label for="prompt">Brief / creative direction</label>
          <textarea
            id="prompt"
            name="prompt"
            required
            maxlength="2000"
            rows="4"
            placeholder="Who is this for? What does the product do? What should viewers see and do next?"
          ></textarea>
          <button class="button ghost small" id="save-prompt" type="button">
            Save prompt
          </button>
        </div>
        <div class="field">
          <label for="script">Approved dialogue</label>
          <textarea
            id="script"
            name="script"
            rows="5"
            maxlength="12000"
            placeholder="Write the words to speak. Leave blank for a scene with no dialogue."
          ></textarea>
          <p id="script-count" class="field-help"></p>
        </div>
        <div class="field-row">
          <div class="field">
            <label for="wording">Writing assistance</label>
            <select id="wording">
              <option value="exact">Keep my wording</option>
              <option value="polish">Polish my wording</option>
              <option value="draft">Draft from my brief</option>
            </select>
          </div>
          <div class="field">
            <label for="delivery-style">Delivery</label>
            <select id="delivery-style">
              <option>Natural and conversational</option>
              <option>Calm and reassuring</option>
              <option>Upbeat and confident</option>
              <option>Curious and surprised</option>
            </select>
          </div>
        </div>
        <button id="prepare-text" type="button" class="button secondary small">
          Prepare brief for review
        </button>
        <p id="prepare-status" class="form-status" role="status"></p>
        <div id="shot-plan" class="shot-plan" hidden></div>
        <div id="presenter-options">
          <div class="inline-divider">PRESENTER VOICE</div>
          <div class="field">
            <label for="voice-source">Narration</label>
            <select id="voice-source">
              <option value="ai">Use an AI voice</option>
              <option value="upload">Use my narration</option>
            </select>
          </div>
          <div id="voice-field" class="field">
            <label for="voice-id">AI voice</label>
            <select id="voice-id"></select>
          </div>
          <div id="audio-field" hidden>
            <label for="audio-reference">Saved narration</label>
            <select id="audio-reference">
              <option value="">Choose saved narration</option>
            </select>
            <div class="upload-zone">
              <div>
                <strong>Upload narration</strong>
                <small id="audio-upload-limits">
                  MP3 or WAV · up to your selected video length · 16 MB
                </small>
              </div>
              <input
                type="file"
                data-upload="audio"
                accept="audio/mpeg,audio/wav,audio/x-wav"
                aria-label="Upload narration"
              />
            </div>
          </div>
          <label class="check-label">
            <input id="caption" type="checkbox" />
            Add presenter captions
          </label>
        </div>
        <p class="field-help" id="scene-input-note" hidden>
          Scenes use generated sound and any approved dialogue. Uploaded
          audio/video references are not enabled until their exact provider
          support is verified. Generated scenes illustrate your brief; they do
          not precisely edit existing footage.
        </p>
      </section>
      <section class="panel">
        <label class="check-label">
          <input type="checkbox" id="approved" required />I have reviewed the
          script and references, have permission to use them, and am ready to
          spend one video allowance.
        </label>
        <p class="field-help">
          Editing this brief after a successful generation requires another
          allowance. Confirmed technical failures restore the affected
          allowance.
        </p>
        <button
          id="generate-button"
          class="button primary full"
          type="submit"
          disabled
        >
          Generate my video
        </button>
        <p id="generation-error" class="form-status" role="alert"></p>
      </section>
    </form>
    <aside class="studio-side">
      <section class="panel preview-panel">
        <div class="panel-header">
          <h2>Your next take</h2>
          <span class="pill" id="preview-resolution">
            1080P
          </span>
        </div>
        <div class="preview-stage" id="preview-stage">
          <div class="preview-placeholder">
            <strong>Your idea starts here.</strong>
            <p>Choose a reference to preview it.</p>
          </div>
        </div>
        <p id="preview-duration" class="pill">
          30-second video
        </p>
        <div
          id="generation-status"
          class="generation-status"
          role="status"
          aria-live="polite"
          hidden
        ></div>
        <p class="fine-print">
          One finished MP4. Download it here or from your library. Generated
          videos are kept for up to 121 days, with the latest 23 available.
        </p>
      </section>
      <div class="prompt-tip">
        <strong>Give every shot a job.</strong>Use a presenter to explain and
        connect. Use relevant product details and cutaways to show the idea. A
        talking portrait stays a presenter video.
      </div>
    </aside>
  </div>
  <section class="panel jobs-panel">
    <h2>Currently in the studio</h2>
    <div id="studio-jobs" class="job-list"></div>
  </section>
</Layout>
