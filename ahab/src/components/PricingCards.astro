---
import { TASKS } from "../lib/offers";
---

<div class="offer-builder panel" id="offer-builder">
  <div class="panel-header">
    <h2>What will you make?</h2>
    <span class="pill">BUY NOW · CREATE LATER</span>
  </div>
  <p class="muted">
    Choose your format and time. Every allowance is a separate video, ready
    whenever you are.
  </p>
  <form id="offer-form">
    <div class="task-grid" role="group" aria-label="Choose a video type">
      {TASKS.map((task, index) => (
        <label class="task-choice">
          <input
            type="radio"
            name="taskType"
            value={task.id}
            checked={index === 0}
          />
          <span>
            <strong>{task.name}</strong>
            <small>{task.description}</small>
          </span>
        </label>
      ))}
    </div>
    <div class="field-row" style="margin-top:24px">
      <div class="field" id="offer-style-field" hidden>
        <label for="offer-style">How will you tell it?</label>
        <select id="offer-style">
          <option value="presenter">Mostly someone speaking</option>
          <option value="scene">Mostly visual scenes</option>
        </select>
      </div>
      <div class="field">
        <label for="offer-duration">Selected duration · seconds</label>
        <input
          id="offer-duration"
          type="number"
          min="5"
          max="120"
          value="30"
          step="1"
          required
        />
      </div>
      <div class="field">
        <label for="offer-resolution">Resolution</label>
        <select id="offer-resolution">
          <option value="1080p">1080p</option>
          <option value="720p">720p · same price</option>
        </select>
      </div>
    </div>
    <div class="field-row">
      <div class="field">
        <label for="offer-service">Delivery</label>
        <select id="offer-service">
          <option value="standard">Standard</option>
        </select>
        <p class="field-help">
          Express appears only when available for your format.
        </p>
      </div>
      <div class="field">
        <label for="offer-quantity">Number of separate allowances</label>
        <input
          id="offer-quantity"
          type="number"
          min="1"
          max="50"
          value="1"
          required
        />
      </div>
    </div>
    <p class="notice" id="offer-duration-note" aria-live="polite"></p>
    <div class="purchase-actions">
      <button class="button secondary" type="submit">
        Add to purchase
      </button>
      <button type="button" class="button ghost" id="add-image-credit">
        Add an image allowance
      </button>
    </div>
  </form>
  <div id="offer-cart" class="offer-cart" aria-live="polite"></div>
  <p class="field-help">
    Each video allowance includes one optional image preparation and three
    writing preparations. Extra image allowances are available above.
    Multiple-purchase rates apply when buying at least two eligible video
    allowances of up to 30 seconds.
  </p>
  <p class="field-help">
    Short videos have a minimum price. The reviewed total includes preparation
    and generation; no extra render fee. Allowances never expire. Download
    finished videos within 121 days.
  </p>
  <div class="purchase-actions">
    <button id="review-purchase" type="button" class="button primary" disabled>
      Review exact price
    </button>
    <button id="pay-purchase" type="button" class="button primary" hidden>
      Continue to payment
    </button>
  </div>
  <p id="offer-status" class="form-status" role="status" aria-live="polite"></p>
</div>
